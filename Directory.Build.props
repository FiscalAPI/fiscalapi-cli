<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Con esto una advertencia IL de trimming/AOT rompe el build y el publish en vez de pasar desapercibida. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      Los avisos de NuGetAudit (vulnerabilidad baja, moderada, alta y crítica en un paquete) siguen siendo
      avisos: dependen de la base de datos de vulnerabilidades del día y romperían el CI sin ningún cambio
      en el repo. Se atienden actualizando el paquete, no apagando el aviso.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!-- El binario no depende de la cultura del equipo; AOT no necesita cargar ICU. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      Sin el sha del commit en AssemblyInformationalVersion: la opción de versión del CLI y el
      User-Agent muestran la versión semántica tal cual, en local y en el CI.
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Convención del repo: un proyecto de pruebas termina en .Tests. -->
    <IsTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
  </PropertyGroup>

  <!--
    Analizadores de trimming y AOT para todo el código que no es de pruebas. Las pruebas corren sobre
    CoreCLR con xUnit, que usa reflexión. PublishAot vive solo en el proyecto del binario.
  -->
  <PropertyGroup Condition="'$(IsTestProject)' != 'true'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

</Project>
